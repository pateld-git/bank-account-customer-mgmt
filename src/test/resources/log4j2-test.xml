<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="warn" monitorInterval="30">
	<Appenders>
		<File name="FileAppender" filename="logs/test-results.log" append = "true">
			<PatternLayout
				pattern="%d{dd MMM yyy HH:mm:ss} [%t] %-5level %logger{36} - %msg%n" />
		</File>
	</Appenders>
	<Loggers>
		<Root level="trace">
			<AppenderRef ref="FileAppender" />
		</Root>
	</Loggers>
</Configuration>