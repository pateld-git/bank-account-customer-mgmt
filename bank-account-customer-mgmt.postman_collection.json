{
	"info": {
		"_postman_id": "bank-account-customer-mgmt-collection-id",
		"name": "Bank Account Customer Management API",
		"description": "Postman Collection for testing the Spring Boot bank-account-customer-mgmt application endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Customer (Person)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has customerId and type is person\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.customerId).to.be.a('number');",
							"    pm.expect(jsonData.type).to.eql('person');",
							"    pm.expect(jsonData.address.city).to.not.be.undefined;",
							"    pm.expect(jsonData.address.province).to.not.be.undefined;",
							"    // Save the created customer ID for subsequent requests",
							"    pm.collectionVariables.set(\"customer_id\", jsonData.customerId);",
							"    console.log(\"Saved customer_id variable: \" + jsonData.customerId);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"type\": \"person\",\n  \"name\": \"Jane Doe\",\n  \"address\": {\n    \"streetNumber\": \"456 Queen St W\",\n    \"postalCode\": \"M5V2H1\"\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8080/api/customers",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"customers"
					]
				},
				"description": "Creates a new Customer of type Person. The Geocoder service will automatically resolve the postal code M5V2H1 to Toronto, ON."
			},
			"response": []
		},
